{
  "version": "1.0",
  "language": "uk",
  "category": "greetings",
  "dialogs": [
    {
      "id": "greeting_001",
      "patterns": [
        "привіт",
        "привіт!",
        "привітик",
        "привіііт",
        "прив"
      ],
      "responses": [
        "Привіт! 😊 Рада тебе бачити.",
        "Привітик! Як справи?",
        "Вітаю! Як проходить твій день?",
        "Привіт. Дуже приємно, що написав.",
        "Хей! 😊 Чим займаєшся?"
      ]
    },
    {
      "id": "greeting_002",
      "patterns": [
        "хай",
        "хей",
        "йо",
        "ку",
        "кусь"
      ],
      "responses": [
        "Хай! 😊",
        "Привіт-привіт!",
        "Рада тебе бачити.",
        "Хей! Як ти сьогодні?",
        "Вітаю! 😊"
      ]
    },
    {
      "id": "greeting_003",
      "patterns": [
        "добрий ранок",
        "доброго ранку",
        "ранок"
      ],
      "responses": [
        "Доброго ранку! ☀️ Гарного тобі дня.",
        "Вітаю! Нехай сьогодні все вдається.",
        "Рада бачити тебе зранку. 😊",
        "Бажаю чудового настрою на весь день.",
        "Доброго ранку! Як спалося?"
      ]
    },
    {
      "id": "greeting_004",
      "patterns": [
        "добрий день",
        "доброго дня",
        "день добрий"
      ],
      "responses": [
        "Добрий день! 😊",
        "Вітаю! Як твої справи?",
        "Приємно, що написав.",
        "Сподіваюся, день проходить добре.",
        "Рада тебе бачити."
      ]
    },
    {
      "id": "greeting_005",
      "patterns": [
        "добрий вечір",
        "доброго вечора",
        "вечір добрий"
      ],
      "responses": [
        "Добрий вечір! 🌙",
        "Гарного вечора тобі.",
        "Рада, що ти написав.",
        "Як пройшов день?",
        "Приємного вечора! 😊"
      ]
    },
    {
      "id": "greeting_006",
      "patterns": [
        "добраніч",
        "на добраніч",
        "ніч"
      ],
      "responses": [
        "На добраніч. 🌙 Гарних снів.",
        "Спокійної ночі. 😊",
        "Нехай тобі насняться лише хороші сни.",
        "Відпочинь гарненько.",
        "До завтра! 🌙"
      ]
    },
    {
      "id": "greeting_007",
      "patterns": [
        "як ти",
        "як справи",
        "як життя",
        "як поживаєш"
      ],
      "responses": [
        "У мене все добре. 😊 А як у тебе?",
        "Чудово, дякую. А ти як?",
        "Все спокійно. Як проходить твій день?",
        "Настрій гарний. 😊",
        "Все добре, дякую що запитав."
      ]
    },
    {
      "id": "greeting_008",
      "patterns": [
        "радий тебе бачити",
        "рада тебе бачити",
        "приємно бачити"
      ],
      "responses": [
        "Мені теж дуже приємно. 😊",
        "Рада це чути.",
        "Дякую, це взаємно.",
        "Мені дуже приємні твої слова.",
        "І я рада нашому спілкуванню."
      ]
    },
    {
      "id": "greeting_009",
      "patterns": [
        "давно не спілкувалися",
        "давно тебе не було",
        "куди пропав"
      ],
      "responses": [
        "Так, давно. 😊 Як ти?",
        "Рада, що ти знову написав.",
        "Я теж скучила за нашим спілкуванням.",
        "Добре, що ти повернувся.",
        "Розповідай, що нового."
      ]
    },
    {
      "id": "greeting_010",
      "patterns": [
        "доброго",
        "вітаю",
        "здоров",
        "здорова"
      ],
      "responses": [
        "Вітаю! 😊",
        "Привіт! Як справи?",
        "Рада тебе бачити.",
        "Гарного тобі дня.",
        "Як настрій сьогодні?"
      ]
    }
  ]
}
